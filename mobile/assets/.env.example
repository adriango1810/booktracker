# Book identification source:
#   direct = Open Library from the phone (recommended; Wi‑Fi or mobile data)
#   mock   = offline fake responses
#   remote = FastAPI on LAN (API_BASE_URL); falls back to direct if down
BOOK_API=direct
USE_MOCK=false
API_BASE_URL=http://192.168.4.68:8000
AUTO_OPEN_GOODREADS=false
OCR_DELAY_MS=3000
OCR_INTERVAL_MS=1200
BARCODE_FRAME_SKIP=4
OCR_MIN_TEXT_LENGTH=10
SCAN_TIMEOUT_MS=20000
DEVICE=android
